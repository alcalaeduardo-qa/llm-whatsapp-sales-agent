# Meta / WhatsApp Cloud API
VERIFY_TOKEN=elige-un-token-largo
APP_SECRET=app-secret-de-tu-app-meta
WHATSAPP_TOKEN=token-de-acceso
PHONE_NUMBER_ID=123456789012345
GRAPH_API_VERSION=v26.0

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-5-5
# Incluye el razonamiento interno del modelo; no bajarlo o las respuestas salen vacías
MAX_TOKENS=16000
SOFIA_EFFORT=low

# Supabase (usar service_role key, solo en backend)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=...

# Agenda (hora México)
HORA_INICIO=14
HORA_FIN=20
MARGEN_HORAS=2

# Datos de pago que Sofía entrega en el cierre
BANCO=
CLABE=
TITULAR=
LINK_STRIPE=
LINK_GUIA=

# true solo en desarrollo: registra el texto completo de los mensajes
LOG_CONTENIDO=false

# Guardrails
CRISIS_LLM=true
CLAUDE_MODEL_CLASIFICADOR=claude-haiku-5-5
MAX_CARACTERES=900
MAX_PARRAFOS=4

# Alertas a Eduardo (bot de @BotFather y tu chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Secreto que eliges tú (letras, números, _ y -). Registra el webhook con
# python -m app.telegram https://tu-url-publica
TELEGRAM_WEBHOOK_SECRET=

# Calendario de Eduardo en iCloud (CalDAV). Contraseña de app de appleid.apple.com, no la del Apple ID
ICLOUD_USUARIO=
ICLOUD_PASSWORD_APP=
ICLOUD_CALENDARIO=Casa
SESION_MINUTOS=60
